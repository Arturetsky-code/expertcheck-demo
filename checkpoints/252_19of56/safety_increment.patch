+def test_volume_parser_does_not_treat_space_planning_adjective_as_volume_metric():
+    from core.assignment_compliance import _parameter
+    assert _parameter('Требования к объемно-планировочным и конструктивным решениям') == ('', None, '')
+    code, value, unit = _parameter('Проектный объем 1,0 м3')
+    assert code == 'VOLUME'
+    assert value == 1.0
+    assert unit in {'м3', 'м³'}
+
+def test_normative_ids_include_pue_and_bibliography_does_not_prove_adoption():
+    from core.assignment_verification_kernel import _normative_ids, verify_assignment_requirement
+    text=('Проектные решения должны соответствовать СП 18.13330.2019, '
+          'СП 4.13130.2013, ПУЭ, СП 37.13330.2012')
+    refs=_normative_ids(text)
+    assert 'пуэ' in refs
+    assert len(refs)==4
+    req={
+        'requirement_type':'NORMATIVE_COMPLIANCE',
+        'source_row_title':'Требования к схеме планировочной организации земельного участка',
+        'requirement_text':text,
+        'evidence_contract_v2':{'expected_sections':['ПЗУ']},
+    }
+    corpus=[
+        {'document':'ПЗУ.pdf','document_type':'ПЗУ','page':10,'text':'Проектом предусмотрена планировочная организация территории и сеть проездов.'},
+        {'document':'ПЗУ.pdf','document_type':'ПЗУ','page':70,'text':'Перечень нормативной документации: СП 18.13330.2019; СП 4.13130.2013; СП 37.13330.2012.'},
+        {'document':'ПЗУ.pdf','document_type':'ПЗУ','page':30,'text':'Согласно СП 37.13330.2012 ширина проезжей части принята 7,5 м.'},
+        {'document':'ПЗУ.pdf','document_type':'ПЗУ','page':29,'text':'Расположение проездов выполнено в соответствии с противопожарными нормами согласно СП 4.13130.2013.'},
+    ]
+    result=verify_assignment_requirement(req,corpus)
+    assert result is None or result.get('status')!='Соответствует заданию'
