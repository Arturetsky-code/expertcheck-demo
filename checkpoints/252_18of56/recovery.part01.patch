+def _site_lighting_check(requirement: dict[str, Any], page_corpus: list[dict[str, Any]]) -> dict[str, Any] | None:
+    """Verify the site-lighting chain from addressable electrical-design passages.
+
+    The Assignment requirement is composite: LED luminaires, mast lighting for the
+    production complex, luminaires on supports for the remaining territory, and
+    illuminance levels tied to SP 52.13330.2016.  A bare normative-reference hit is
+    not enough; all engineering slots must be present in the profile section.
+    """
+    text = str(requirement.get("requirement_text") or "")
+    low_req = _norm(text)
+    if not all(token in low_req for token in ("светодиод", "освещ", "мачт")):
+        return None
+    if not any(token in low_req for token in ("консольн", "опор")):
+        return None
+
+    slots = {"led": None, "masts": None, "supports": None, "norm": None}
+    for page in _candidate_pages(page_corpus, ("ИОС1",)):
+        raw = str(page.get("text") or "")
+        low = _norm(raw)
+        if slots["led"] is None and "светодиод" in low and "светильник" in low:
+            slots["led"] = page
+        if slots["masts"] is None and "осветительн" in low and "мачт" in low:
+            slots["masts"] = page
+        if slots["supports"] is None and "наружн" in low and "светильник" in low and "опор" in low:
+            slots["supports"] = page
+        if slots["norm"] is None and "сп 52.13330.2016" in low:
+            slots["norm"] = page
+    if not all(slots.values()):
+        return None
+
+    anchors = {
+        "led": ("светодиод", "светильник"),
+        "masts": ("осветительн", "мачт"),
+        "supports": ("наружн", "опор"),
+        "norm": ("сп 52.13330.2016",),
+    }
+    evidence=[]; seen=set()
+    for key,page in slots.items():
+        ident=(page.get("document"),page.get("page"))
+        if ident in seen:
+            continue
+        seen.add(ident)
+        snippet=_context(raw=page.get("text") or "", anchors=anchors[key], radius=560) if False else _context(page.get("text") or "", anchors[key], radius=560)
+        evidence.append({
+            "evidence_kind":"SITE_LIGHTING_SYSTEM_CHAIN",
+            "evidence_state":"verified_candidate",
+            "document":page.get("document"),
+            "document_type":page.get("document_type"),
+            "page":page.get("page"),
+            "context":snippet,
+            "score":98,
+            "proof_slot":key,
+        })
+    return {
+        "status":"Соответствует заданию",
+        "evidence":[f"{e['document']}, стр. {e['page']}: {e['context']}" for e in evidence],
+        "evidence_candidates":evidence,
+        "verification_evidence":evidence,
+        "evidence_quality_state":"VERIFIED_ENGINEERING_EVIDENCE",
+        "match_confidence":0.98,
+        "decision_basis":"Система электроосвещения подтверждена профильным разделом: светодиодные светильники, наружное освещение на опорах, осветительные мачты и нормирование по СП 52.13330.2016.",
+        "verification_kernel":"SITE_LIGHTING_EXECUTOR",
+    }
